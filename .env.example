# Salin ke .env lalu sesuaikan
DATABASE_URL="file:./dev.db"
BETTER_AUTH_SECRET="ganti-dengan-secret-acak"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Service core-ai (AI/OCR/sourcing web/PDF render) — proses terpisah.
# Jalankan: pnpm dev:ai (atau docker compose up -d core-ai)
# Kosongkan untuk mode mock lokal tanpa service.
CORE_AI_URL="http://localhost:8787"
# Harus sama dengan CORE_AI_API_KEY di core-ai/.env (opsional)
CORE_AI_API_KEY=""

# Konfigurasi AI/LLM/OCR/sourcing kini di core-ai/.env.example
# (AI_PROVIDER, OLLAMA_*, SOURCING_PROVIDER, FIRECRAWL_API_KEY, GOTENBERG_URL)

# PDF server-side (M4) — render lewat core-ai (disarankan) atau langsung Gotenberg.
# Fallback tanpa keduanya: print browser.
# GOTENBERG_URL="http://localhost:3001"   # legacy: render langsung dari app
# URL app dari sudut pandang container Gotenberg
INTERNAL_APP_URL="http://host.docker.internal:3000"
# Secret route print internal (fallback: BETTER_AUTH_SECRET)
PDF_INTERNAL_SECRET=""
# Cache PDF dokumen terbit (immutable per revisi)
PDF_CACHE_DIR=".data/pdf"

# Email (mock-first) — "mock" log ke console; "resend" kirim sungguhan
MAIL_PROVIDER="mock"
RESEND_API_KEY=""
MAIL_FROM="SalesKit <noreply@example.com>"
# Secret untuk endpoint cron /api/cron/reminders
CRON_SECRET="ganti-dengan-secret-acak"

# Salin ke .env lalu sesuaikan
DATABASE_URL="file:./dev.db"
BETTER_AUTH_SECRET="ganti-dengan-secret-acak"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Service core-ai (AI/OCR/sourcing web/PDF render) — proses terpisah.
# Jalankan: pnpm dev:ai (atau docker compose up -d core-ai)
# Kosong = fitur remote nonaktif; sourcing live melaporkan NOT_CONFIGURED.
CORE_AI_URL="http://localhost:8787"
# Harus sama dengan CORE_AI_API_KEY di core-ai/.env (opsional)
CORE_AI_API_KEY=""
# OCR lokal Tesseract: budget backend 120 detik + margin 30 detik.
# Untuk Ollama Vision, sesuaikan dengan budget backend (legacy: 510000).
OCR_REQUEST_TIMEOUT_MS="150000"

# Sourcing: demo hanya jika dipilih eksplisit; ganti "live" untuk provider via core-ai.
SOURCING_MODE="mock"
# Live: "firecrawl" (default jika variabel tidak ada) atau "selfhost".
# Harus sama dengan SOURCING_PROVIDER di core-ai; nilai kosong/tidak valid memberi NOT_CONFIGURED.
# Setup lokal tanpa key Cloud/model: pnpm setup:selfhost (bukan untuk produksi).
SOURCING_LIVE_PROVIDER="firecrawl"
# Saran jual hanya untuk IDR, dibulatkan ke ribuan. Rentang 0-500.
SOURCING_MARGIN_PERCENT="30"

# Konfigurasi AI/LLM/OCR/sourcing kini di core-ai/.env.example
# (AI_PROVIDER, OCR_PROVIDER, OLLAMA_*, SOURCING_PROVIDER, FIRECRAWL_API_KEY, GOTENBERG_URL,
# SEARXNG_URL, SOURCING_BROWSER_URL, SOURCING_BROWSER_ENGINE).
# SOURCING_BROWSER_API_KEY dan SEARXNG_SECRET juga hanya di backend, bukan di app/NEXT_PUBLIC_*.

# PDF server-side (M4) — render lewat core-ai (disarankan) atau langsung Gotenberg.
# Fallback tanpa keduanya: print browser.
# GOTENBERG_URL="http://localhost:3001"   # legacy: render langsung dari app
# URL app dari sudut pandang container Gotenberg
INTERNAL_APP_URL="http://host.docker.internal:3000"
# Secret route print internal (fallback: BETTER_AUTH_SECRET)
PDF_INTERNAL_SECRET=""
# Cache PDF dokumen terbit (immutable per revisi)
PDF_CACHE_DIR=".data/pdf"

# Email (mock-first) — "mock" log ke console; "resend" kirim sungguhan
MAIL_PROVIDER="mock"
RESEND_API_KEY=""
MAIL_FROM="SalesKit <noreply@example.com>"
# Secret untuk endpoint cron /api/cron/reminders
CRON_SECRET="ganti-dengan-secret-acak"

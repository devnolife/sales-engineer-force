# Salin ke .env lalu sesuaikan
DATABASE_URL="file:./dev.db"
BETTER_AUTH_SECRET="ganti-dengan-secret-acak"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AI_PROVIDER="mock"
# AI_PROVIDER="ollama" untuk LLM lokal via Ollama:
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"
# Model vision utk OCR gambar & PDF scan (butuh poppler `pdftoppm` utk PDF scan)
OLLAMA_VISION_MODEL="qwen2.5vl:latest"
# Context OCR: 8192 muat penuh di GPU 46GB (32k default = 51GB -> jatuh ke CPU!)
OLLAMA_OCR_NUM_CTX="8192"
SOURCING_PROVIDER="mock"
# Pencarian vendor nyata di web: SOURCING_PROVIDER="firecrawl" + isi API key
# (daftar gratis di https://firecrawl.dev)
FIRECRAWL_API_KEY=""

# PDF server-side (M4) — kosongkan untuk fallback print browser
# Jalankan: docker compose up -d gotenberg
GOTENBERG_URL="http://localhost:3001"
# URL app dari sudut pandang container Gotenberg
INTERNAL_APP_URL="http://host.docker.internal:3000"
# Secret route print internal (fallback: BETTER_AUTH_SECRET)
PDF_INTERNAL_SECRET=""
# Cache PDF dokumen terbit (immutable per revisi)
PDF_CACHE_DIR=".data/pdf"

# Email (mock-first) — "mock" log ke console; "resend" kirim sungguhan
MAIL_PROVIDER="mock"
RESEND_API_KEY=""
MAIL_FROM="SalesKit <noreply@example.com>"
# Secret untuk endpoint cron /api/cron/reminders
CRON_SECRET="ganti-dengan-secret-acak"

// DIGENERATE dari schema.prisma via pnpm db:schema:pg — jangan edit manual.
// SalesKit — skema database (kerangka mock-first)
//
// CATATAN PENTING (SQLite):
// - SQLite tidak mendukung `enum` Prisma  -> pakai String + validasi zod di boundary.
// - SQLite tidak mendukung `Decimal`      -> semua uang/qty disimpan sebagai String
//   (angka desimal presisi penuh), dihitung dengan decimal.js di server.
//   Saat migrasi ke PostgreSQL (produksi): kolom-kolom ini menjadi Decimal.
// - Semua tabel data aplikasi punya `organizationId` (isolasi tenant, PRD §8.2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH (Better Auth + organization plugin) — dikelola Better Auth
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]

  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members     Member[]
  invitations Invitation[]
  settings    OrgSettings?

  @@map("organization")
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member") // owner | admin | member (member = sales)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitation")
}

// ============================================================
// PENGATURAN ORGANISASI (kop, format nomor, PPN, rekening, dsb.)
// ============================================================

model OrgSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  // Identitas di kop surat
  address String?
  npwp    String?
  phone   String?
  email   String?
  website String?

  // Penomoran penawaran
  numberPrefix String @default("SPH") // contoh hasil: 001/SPH/VII/2026
  numberFormat String @default("{seq:3}/{prefix}/{romanMonth}/{year}")
  revisionMode String @default("SUFFIX") // SUFFIX (Rev.N) | NEW_NUMBER

  // Kalkulasi
  vatRate String @default("0.11") // desimal string

  // Rekening bank (dicetak di dokumen)
  bankName    String?
  bankAccount String?
  bankBranch  String?
  bankHolder  String?

  // Penandatangan
  signerName  String?
  signerTitle String?

  // Default syarat & ketentuan penawaran
  defaultFranco           String?
  defaultDeliveryTime     String?
  defaultTermsOfPayment   String?
  defaultPriceIncludeNote String?
  defaultValidityDays     Int     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_settings")
}

// ============================================================
// KATALOG PRODUK
// ============================================================

model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  products Product[]

  @@unique([organizationId, name])
  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String?
  name           String
  brand          String?
  type           String?
  spec           String?
  unit           String   @default("Unit")
  defaultPrice   String? // desimal string
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([organizationId, name])
  @@map("products")
}

// ============================================================
// PELANGGAN
// ============================================================

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  city           String?
  phone          String?
  email          String?
  npwp           String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts   ContactPerson[]
  deals      Deal[]
  quotations Quotation[]

  @@index([organizationId, name])
  @@map("customers")
}

model ContactPerson {
  id             String  @id @default(cuid())
  organizationId String
  customerId     String
  name           String
  title          String?
  phone          String? // WA
  email          String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("contact_persons")
}

// ============================================================
// PIPELINE (Deal, Aktivitas, Reminder)
// ============================================================

model Deal {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  title          String
  stage          String    @default("LEAD") // LEAD | QUOTED | NEGOTIATION | WON | LOST
  value          String    @default("0") // desimal string; auto dari penawaran terakhir
  ownerId        String // userId sales pemilik deal
  lostReason     String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer   Customer    @relation(fields: [customerId], references: [id])
  quotations Quotation[]
  activities Activity[]
  reminders  Reminder[]

  @@index([organizationId, stage])
  @@index([organizationId, ownerId])
  @@map("deals")
}

model Activity {
  id             String   @id @default(cuid())
  organizationId String
  dealId         String
  type           String // CALL | MEETING | CHAT | NOTE
  content        String
  happenedAt     DateTime @default(now())
  createdById    String
  createdAt      DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("activities")
}

model Reminder {
  id             String    @id @default(cuid())
  organizationId String
  dealId         String
  dueAt          DateTime
  note           String
  done           Boolean   @default(false)
  doneAt         DateTime?
  assigneeId     String? // userId
  createdAt      DateTime  @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, done, dueAt])
  @@map("reminders")
}

// ============================================================
// PENAWARAN (port dari Metito, digeneralisasi multi-tenant)
// ============================================================

// Counter atomik per (organisasi, tahun) — nomor terbit hanya saat issue.
model QuotationCounter {
  organizationId String
  year           Int
  lastSeq        Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@id([organizationId, year])
  @@map("quotation_counters")
}

model Quotation {
  id             String  @id @default(cuid())
  organizationId String
  status         String  @default("DRAFT") // DRAFT | SENT | WON | LOST (EXPIRED = derived)

  // Relasi sumber (bukan bagian snapshot dokumen)
  dealId     String?
  customerId String?

  // Penomoran — null selama draft; nomor "dibakar" hanya saat issue
  seq        Int?
  numberBase String?
  revision   Int       @default(0) // 0 = asli, 1 = Rev.1, dst.
  parentId   String?
  issuedAt   DateTime?
  quoteDate  DateTime  @default(now())
  validUntil DateTime?

  // ---- SNAPSHOT dokumen (beku saat issue; perubahan master tidak mengubah dokumen) ----
  customerName     String
  attn             String?
  subject          String
  franco           String?
  deliveryTime     String?
  termsOfPayment   String?
  priceIncludeNote String?
  validityDays     Int     @default(30)

  // Snapshot identitas organisasi (menutup celah Metito: bank/signer ikut beku)
  orgName     String?
  orgAddress  String?
  orgNpwp     String?
  orgPhone    String?
  orgEmail    String?
  orgLogo     String?
  bankName    String?
  bankAccount String?
  bankBranch  String?
  bankHolder  String?
  signerName  String?
  signerTitle String?

  // Kalkulasi (desimal string; dihitung server-side, tidak pernah dari client)
  vatRate         String @default("0.11")
  docDiscountType String @default("AMOUNT") // AMOUNT | PERCENT
  docDiscountValue String @default("0")
  subtotal        String @default("0")
  discountAmount  String @default("0") // diskon dokumen (nominal terhitung)
  vatAmount       String @default("0")
  total           String @default("0")
  amountInWords   String @default("")

  // Share link publik
  publicToken   String?   @unique
  firstViewedAt DateTime?
  viewCount     Int       @default(0)

  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deal      Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  customer  Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  parent    Quotation?      @relation("QuotationRevisions", fields: [parentId], references: [id])
  revisions Quotation[]     @relation("QuotationRevisions")
  items     QuotationItem[]
  inquiries Inquiry[]

  @@unique([organizationId, numberBase, revision])
  @@index([organizationId, status])
  @@index([organizationId, quoteDate])
  @@map("quotations")
}

model QuotationItem {
  id             String  @id @default(cuid())
  organizationId String
  quotationId    String
  lineNo         Int
  productId      String? // link ke katalog (opsional; item boleh ketik bebas)
  name           String
  brand          String?
  type           String?
  spec           String?
  qty            String // desimal string (maks 3 dp)
  unit           String
  unitPrice      String // desimal string
  discountPercent String @default("0") // diskon per-item (%)
  lineTotal      String // desimal string (terhitung server-side)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([organizationId, name])
  @@map("quotation_items")
}

// ============================================================
// PERMINTAAN MASUK (inquiry) — upload/paste → ekstraksi (mock AI)
// ============================================================

model Inquiry {
  id             String    @id @default(cuid())
  organizationId String
  source         String    @default("UPLOAD") // UPLOAD | PASTE
  status         String    @default("NEW") // NEW | EXTRACTED | REVIEWED | QUOTED | ARCHIVED
  customerId     String?
  customerName   String? // hasil ekstraksi / input manual
  fileName       String?
  filePath       String? // path lokal .data/uploads (mock storage)
  rawText        String? // isi teks permintaan (paste / hasil baca file)
  extractedAt    DateTime?
  quotationId    String? // draft penawaran hasil konversi
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items     InquiryItem[]
  quotation Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("inquiries")
}

model InquiryItem {
  id             String  @id @default(cuid())
  organizationId String
  inquiryId      String
  lineNo         Int
  rawText        String // baris asli dari dokumen permintaan
  name           String
  qty            String  @default("1")
  unit           String?
  spec           String?
  // Hasil pencocokan ke katalog (mock AI matching)
  matchedProductId String?
  matchStatus      String  @default("UNMATCHED") // MATCHED | SUGGESTED | UNMATCHED
  matchScore       Float?
  note             String?

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@map("inquiry_items")
}

// ============================================================
// SOURCING VENDOR (database vendor + hasil pencarian mock)
// ============================================================

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  city           String?
  phone          String?
  email          String?
  website        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products VendorProduct[]

  @@index([organizationId, name])
  @@map("vendors")
}

model VendorProduct {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String
  name           String
  brand          String?
  spec           String?
  unit           String   @default("Unit")
  price          String // desimal string (harga beli/modal)
  currency       String   @default("IDR")
  sourceType     String   @default("MANUAL") // MANUAL | IMPORT | WEB_MOCK
  sourceUrl      String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([organizationId, name])
  @@index([vendorId])
  @@map("vendor_products")
}

// Log pencarian vendor (hasil disimpan sebagai JSON string — SQLite tanpa tipe Json)
model SourcingSearch {
  id             String   @id @default(cuid())
  organizationId String
  query          String
  provider       String   @default("mock") // mock | firecrawl (nanti)
  resultsJson    String // JSON string: kandidat vendor + harga indikatif
  inquiryItemId  String?
  createdById    String
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("sourcing_searches")
}

// ============================================================
// LOG AI (human-in-the-loop sejak hari 1 — sekarang provider mock)
// ============================================================

model AiLog {
  id             String   @id @default(cuid())
  organizationId String
  kind           String // INQUIRY_EXTRACTION | PRODUCT_MATCH | VENDOR_SEARCH
  provider       String   @default("mock")
  inputSummary   String
  outputSummary  String
  accepted       Boolean? // null = belum direview; true/false = diterima/ditolak user
  createdById    String
  createdAt      DateTime @default(now())

  @@index([organizationId, kind])
  @@map("ai_logs")
}
